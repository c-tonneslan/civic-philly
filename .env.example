# Postgres with PostGIS. Use Supabase or Neon for prod.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civic_philly

# Resend API key for "alert when project lands near me" emails.
# https://resend.com/api-keys
RESEND_API_KEY=re_xxx
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Mapbox/MapTiler key only needed if you swap the default tile source.
# Default uses the free demo style from MapLibre.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Geocoder for the "what's near me" lookup. Default is Nominatim
# (free, please respect their usage policy in production).
NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search
